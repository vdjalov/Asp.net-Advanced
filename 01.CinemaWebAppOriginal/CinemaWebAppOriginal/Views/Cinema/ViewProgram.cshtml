@using CinemaWebAppOriginal.Services.Data.Interfaces
@using CinemaWebAppOriginal.ViewModels;
@using CinemaWebAppOriginal.ViewModels.Cinema

@model CinemaProgramViewModel;
@inject IManagerService managerService;

@{
    Guid userId = Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
    ViewData["Title"] = "Cinema Program";
}

<h2 class="my-4 text-center display-4">Cinema Program - @Model.Name</h2>
<p class="text-center lead"><strong>Location:</strong> @Model.Location</p>

<div id="manageTicketsModalContainer">
    <partial name="~/Views/Ticket/_ManageTicketsModal.cshtml" model="Model.Movies"><partial />
    @* <partial name="~/Views/Ticket/_BuyTicketModal.cshtml" model="Model.Movies"><partial /> *@
</div>

<div class="container mt-5">
    @if (Model.Movies.Any())
    {
        <div class="row">
            @foreach (var movie in Model.Movies)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-center font-weight-bold">@movie.Title</h5>
                            <p class="card-text text-muted text-center"><em>@movie.Genre</em></p>
                            <p class="card-text"><strong>Duration:</strong> @movie.Duration</p>
                            <p class="card-text text-justify" style="font-size: 0.9rem;">@movie.Description</p>
                        </div>
                        <div class="card-footer bg-transparent text-center">
                            @if (!string.IsNullOrEmpty(userId.ToString()) && await this.managerService.IsUserAManager(userId))
                            {
                                <button type="button" class="btn btn-primary btn-sm" onclick="openManageTicketsModal('@Model.Id')">
                                    <i class="bi bi-ticket-perforated"></i> Manage Tickets
                                </button>
                            
                            }
                            else
                            {
                              @*   <button type="button" class="btn btn-primary btn-sm" onclick="buyTicketsModal('@movie.Id')">
                                    <i class="bi bi-ticket-perforated"></i> Buy Ticket
                                </button> *@
                                
                                <div class="card-footer" bg-transparent text-centre>
                                    <a href="javascript:void(0)" class="btn btn-success btn-sm w-75 buy-ticket-btn"
                                       data-cinema-id='@Model.Id' 
                                       data-movie-id="@movie.Id">
                                        <i class="bi bi-ticket-perforated"></i> Buy Ticket
                                    </a>
                                </div>
                              
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">There are no movies scheduled for this cinema currently.</p>
    }
</div>


<script src="~/js/manageTickets.js" asp-append-version="true"></script>
@* <script src="~/js/buyTickets.js" asp-append-version="true"></script> *@

<div class="text-center mt-5">
    <a asp-action="Index" class="btn btn-secondary btn-lg px-4">
        <i class="bi bi-arrow-left-circle"></i> Back to Cinemas
    </a>
</div>

@await Html.PartialAsync("~/Views/Ticket/_BuyTicketModal.cshtml")



